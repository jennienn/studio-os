# Copy to .env and fill locally. Never commit .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SERVER_PORT=8080
# false ONLY for local HTTP; production must use true with HTTPS.
SESSION_COOKIE_SECURE=true
# Build-time opt-in for isolated visual prototype; default disabled.
NEXT_PUBLIC_ENABLE_DEMO=false
# Local development only. Do not enable the local mail adapter in production.
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:3000
# Frontend server/build setting, never a browser credential.
BACKEND_BASE_URL=http://127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
